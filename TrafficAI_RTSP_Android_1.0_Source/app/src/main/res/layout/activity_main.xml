                        <EditText android:id="@+id/fullUrlInput" android:layout_width="match_parent" android:layout_height="46dp" android:hint="URL RTSP đầy đủ (ưu tiên nếu có)" android:inputType="textUri" android:singleLine="true" android:textColor="#24262D" android:textColorHint="#767985" android:textSize="12sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <EditText android:id="@+id/hostInput" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="2" android:hint="IP camera" android:inputType="textUri" android:singleLine="true" android:textColor="#24262D" android:textColorHint="#767985" />
                            <EditText android:id="@+id/portInput" android:layout_width="70dp" android:layout_height="44dp" android:hint="Port" android:inputType="number" android:singleLine="true" android:text="554" android:textColor="#24262D" />
                            <EditText android:id="@+id/userInput" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:hint="User" android:singleLine="true" android:text="admin" android:textColor="#24262D" />
                        </LinearLayout>
                        <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="44dp" android:hint="Mật khẩu / Safety Code (không lưu)" android:inputType="textPassword" android:singleLine="true" android:textColor="#24262D" android:textColorHint="#767985" />
                        <EditText android:id="@+id/pathInput" android:layout_width="match_parent" android:layout_height="44dp" android:hint="Đường dẫn RTSP" android:singleLine="true" android:text="/cam/realmonitor?channel=1&amp;subtype=0&amp;unicast=true&amp;proto=Onvif" android:textColor="#24262D" android:textSize="10sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
