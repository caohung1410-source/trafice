                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:paddingTop="16dp" android:text="HUD BẢN ĐỒ TOÀN MÀN HÌNH" android:textColor="#236A9D" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dùng menu nổi để chuyển nhanh Bản đồ / Camera. AI vẫn đọc khung hình nền khi đang xem bản đồ." android:textColor="#5C5F69" android:textSize="11sp" />
                </LinearLayout>
            </ScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="Version: 2.5.0 • Map-first UI"
                android:textColor="#60626C"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
