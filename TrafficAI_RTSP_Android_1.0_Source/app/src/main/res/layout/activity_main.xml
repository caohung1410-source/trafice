                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="4dp" android:paddingTop="8dp" android:text="MÁY CHỦ MỞ • CHỈ THAY KHI DỊCH VỤ MẶC ĐỊNH BỊ CHẶN" android:textColor="#747783" android:textSize="9sp" />
                    <EditText android:id="@+id/geocoderUrlInput" android:layout_width="match_parent" android:layout_height="42dp" android:hint="Máy chủ tìm kiếm Nominatim" android:inputType="textUri" android:singleLine="true" android:text="https://nominatim.openstreetmap.org" android:textColor="#24262D" android:textSize="10sp" />
                    <EditText android:id="@+id/routingUrlInput" android:layout_width="match_parent" android:layout_height="42dp" android:hint="Máy chủ định tuyến OSRM" android:inputType="textUri" android:singleLine="true" android:text="https://router.project-osrm.org" android:textColor="#24262D" android:textSize="10sp" />
                    <EditText android:id="@+id/overpassUrlInput" android:layout_width="match_parent" android:layout_height="42dp" android:hint="Máy chủ dữ liệu Overpass" android:inputType="textUri" android:singleLine="true" android:text="https://overpass-api.de/api/interpreter" android:textColor="#24262D" android:textSize="10sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:paddingTop="16dp" android:text="ƯU TIÊN LÀN QUAN SÁT" android:textColor="#236A9D" android:textSize="12sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/laneLeftButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="← TRÁI" />
