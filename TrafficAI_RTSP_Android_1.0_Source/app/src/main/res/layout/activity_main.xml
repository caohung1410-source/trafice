<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECE9E8">

    <FrameLayout
        android:id="@+id/drivingScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/videoFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#080B10">

            <org.maplibre.android.maps.MapView
                android:id="@+id/baseMapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <vn.bachphuc.trafficai.OfflineGpsView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible"
                app:resize_mode="fit"
                app:show_buffering="always"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <TextureView
                android:id="@+id/phoneCameraView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <vn.bachphuc.trafficai.DetectionOverlayView
                android:id="@+id/overlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/aiBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="104dp"
                android:background="@drawable/hud_capsule"
                android:padding="7dp"
                android:text="AI: CHƯA MỞ"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/visionQualityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="88dp"
                android:background="@drawable/alert_banner"
                android:elevation="4dp"
                android:paddingBottom="6dp"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:text="AI ĐANG QUÉT • 0%"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cameraSourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="176dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/hud_capsule"
                android:padding="7dp"
                android:text="CAMERA: CHƯA CHỌN"
                android:textColor="#BFE9FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/roadAlertBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="18dp"
                android:background="@drawable/hud_capsule"
                android:maxWidth="250dp"
                android:padding="8dp"
                android:text="ĐANG QUAN SÁT PHÍA TRƯỚC"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="142dp"
            android:layout_height="142dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/speedResult"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/speed_gauge_background"
                android:gravity="center"
                android:text="GPS\n—"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speedLimitResult"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/speed_limit_background"
                android:elevation="9dp"
                android:gravity="center"
                android:text="—"
                android:textColor="#152130"
                android:textSize="17sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/soundToggleButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/map_control_button"
            android:contentDescription="Bật hoặc tắt cảnh báo giọng nói"
            android:elevation="9dp"
            android:padding="15dp"
            android:src="@drawable/ic_volume_dark" />

        <LinearLayout
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/zoomInButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/map_control_button"
                android:elevation="9dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="#2E2F36"
                android:textSize="31sp" />

            <Button
                android:id="@+id/zoomOutButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/map_control_button"
                android:elevation="9dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="−"
                android:textAllCaps="false"
                android:textColor="#2E2F36"
                android:textSize="31sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navigationPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginEnd="14dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="90dp"
            android:background="@drawable/map_search_panel"
            android:elevation="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/destinationSearchInput"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:backgroundTint="#8C8E98"
                    android:hint="Tìm điểm đến hoặc nói…"
                    android:imeOptions="actionGo"
                    android:inputType="textPostalAddress"
                    android:singleLine="true"
                    android:textColor="#24262D"
                    android:textColorHint="#777A85"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/voiceSearchButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/lane_button"
                    android:contentDescription="Tìm bằng giọng nói"
                    android:padding="11dp"
                    android:src="@drawable/ic_mic" />

                <ImageButton
                    android:id="@+id/routeButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/lane_button"
                    android:contentDescription="Bắt đầu tìm đường"
                    android:padding="11dp"
                    android:src="@drawable/ic_route" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/navigationInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Chưa chọn điểm đến"
                        android:textColor="#24262D"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tripSummaryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GPS sẽ hiển thị quãng đường và thời gian dự kiến"
                        android:textColor="#686B76"
                        android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/clearRouteButton"
                    android:layout_width="62dp"
                    android:layout_height="38dp"
                    android:background="@drawable/lane_button"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="DỪNG"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="154dp"
            android:layout_marginEnd="12dp"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lightResult"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="0.9"
                    android:background="@drawable/hud_capsule"
                    android:gravity="center"
                    android:text="ĐÈN\n—"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/countdownResult"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="0.75"
                    android:background="@drawable/hud_capsule"
                    android:gravity="center"
                    android:text="GIÂY\n—"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/signResult"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.55"
                    android:background="@drawable/hud_capsule"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="BIỂN BÁO • —"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/hazardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/hud_capsule"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="32dp"
                android:text="PHÍA TRƯỚC • ĐANG QUAN SÁT"
                android:textColor="#DDEEFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/quickSearchButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/map_control_button"
                android:contentDescription="Tìm kiếm và chỉ đường"
                android:elevation="9dp"
                android:padding="14dp"
                android:src="@drawable/ic_search_dark" />

            <ImageButton
                android:id="@+id/quickMenuButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/map_control_button"
                android:contentDescription="Mở menu nhanh"
                android:elevation="9dp"
                android:padding="14dp"
                android:src="@drawable/ic_menu_dark" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/assistantActionButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="18dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/map_control_button"
            android:contentDescription="Trợ lý và báo cáo sự cố"
            android:elevation="12dp"
            android:padding="8dp"
            android:src="@drawable/ic_traffic_auto" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="52dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/hud_capsule"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="250dp"
                android:text="TrafficAI 2.5 • sẵn sàng"
                android:textColor="#B7F3CB"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/driveModeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRỢ LÝ LÁI XE • ARM64"
                android:textColor="#26333C"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/modelProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="180dp"
                android:layout_height="3dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/quickMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/quick_menu_scrim"
        android:clickable="true"
        android:elevation="20dp"
        android:focusable="true"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/closeQuickMenuButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="22dp"
            android:background="@android:color/transparent"
            android:contentDescription="Đóng menu nhanh"
            android:padding="10dp"
            android:src="@drawable/ic_close" />

        <GridLayout
            android:layout_width="270dp"
            android:layout_height="270dp"
            android:layout_gravity="center"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="true">

            <Button
                android:id="@+id/overlaySearchButton"
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:background="@drawable/map_control_button"
                android:drawablePadding="8dp"
                android:drawableTop="@drawable/ic_search_dark"
                android:text="TÌM KIẾM"
                android:textColor="#2E2F36"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/mapButton"
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:background="@drawable/map_control_button"
                android:drawablePadding="8dp"
                android:drawableTop="@drawable/ic_route_dark"
                android:text="CAMERA"
                android:textColor="#2E2F36"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/toggleSettingsButton"
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:background="@drawable/map_control_button"
                android:contentDescription="Mở cài đặt"
                android:padding="38dp"
                android:src="@drawable/ic_settings_dark" />

            <Button
                android:id="@+id/overlayReportButton"
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:background="@drawable/map_control_button"
                android:text="!\nBÁO SỰ CỐ"
                android:textColor="#E08B00"
                android:textSize="13sp"
                android:textStyle="bold" />
        </GridLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/incidentOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000"
        android:clickable="true"
        android:elevation="22dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bottom_sheet_background"
            android:orientation="vertical"
            android:paddingBottom="22dp"
            android:paddingEnd="18dp"
            android:paddingStart="18dp"
            android:paddingTop="8dp">

            <View
                android:layout_width="64dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="#D2D3D8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Báo cáo sự cố trên đường"
                    android:textColor="#25262C"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/closeIncidentButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Đóng báo cáo"
                    android:padding="12dp"
                    android:src="@drawable/ic_close_dark" />
            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:rowCount="3"
                android:useDefaultMargins="true">

                <Button android:id="@+id/incidentRecordingButton" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/incident_tile_background" android:text="●\nGhi hình\nsự kiện" android:textColor="#303139" android:textSize="11sp" />
                <Button android:id="@+id/incidentLiveButton" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/incident_tile_background" android:text="▣ LIVE\nCamera" android:textColor="#303139" android:textSize="11sp" />
                <Button android:id="@+id/incidentCongestionButton" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/incident_tile_background" android:text="🚗\nKẹt xe" android:textColor="#303139" android:textSize="11sp" />
                <Button android:id="@+id/incidentAccidentButton" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/incident_tile_background" android:text="⚠\nTai nạn" android:textColor="#303139" android:textSize="11sp" />
                <Button android:id="@+id/incidentRoadworkButton" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/incident_tile_background" android:text="△\nThi công" android:textColor="#303139" android:textSize="11sp" />
                <Button android:id="@+id/incidentObstacleButton" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/incident_tile_background" android:text="▰\nVật cản" android:textColor="#303139" android:textSize="11sp" />
                <Button android:id="@+id/incidentFloodButton" android:layout_width="0dp" android:layout_height="112dp" android:layout_columnWeight="1" android:background="@drawable/incident_tile_background" android:text="≈\nĐường ngập" android:textColor="#303139" android:textSize="11sp" />
            </GridLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1F1F7"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="14dp"
                android:paddingStart="12dp">

                <ImageButton
                    android:id="@+id/closeSettingsButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Quay lại"
                    android:padding="12dp"
                    android:src="@drawable/ic_back_dark" />

                <TextView
                    android:id="@+id/settingsTitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cài đặt"
                    android:textColor="#2B2C32"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DADBE2" />

            <ScrollView
                android:id="@+id/settingsHomeList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="18dp"
                    android:paddingStart="18dp"
                    android:paddingTop="14dp">

                    <LinearLayout android:id="@+id/settingsAccountRow" android:layout_width="match_parent" android:layout_height="66dp" android:background="@drawable/settings_row_background" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"><TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="●" android:textColor="#303139" android:textSize="20sp"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tài khoản" android:textColor="#303139" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#303139" android:textSize="31sp"/></LinearLayout>
                    <LinearLayout android:id="@+id/settingsMapRow" android:layout_width="match_parent" android:layout_height="66dp" android:background="@drawable/settings_row_background" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"><TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="▥" android:textColor="#303139" android:textSize="21sp"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cài đặt bản đồ" android:textColor="#303139" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#303139" android:textSize="31sp"/></LinearLayout>
