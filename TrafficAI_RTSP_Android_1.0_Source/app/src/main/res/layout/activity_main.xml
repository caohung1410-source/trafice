<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111F"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TrafficAI RTSP 1.0"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IMOU C22E-A và camera RTSP H.264"
                android:textColor="#90A8C0"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/toggleSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="ẨN" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/panel_background"
        android:orientation="vertical">

        <EditText
            android:id="@+id/fullUrlInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="URL RTSP đầy đủ (ưu tiên nếu có)"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890A8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/hostInput"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="2"
                android:hint="IP camera"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#7890A8" />

            <EditText
                android:id="@+id/portInput"
                android:layout_width="72dp"
                android:layout_height="46dp"
                android:hint="Port"
                android:inputType="number"
                android:singleLine="true"
                android:text="554"
                android:textColor="#FFFFFF"
                android:textColorHint="#7890A8" />

            <EditText
                android:id="@+id/userInput"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:hint="User"
                android:singleLine="true"
                android:text="admin"
                android:textColor="#FFFFFF"
                android:textColorHint="#7890A8" />
        </LinearLayout>

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:hint="Mật khẩu / Safety Code (không lưu)"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890A8" />

        <EditText
            android:id="@+id/pathInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:hint="Đường dẫn RTSP"
            android:singleLine="true"
            android:text="/cam/realmonitor?channel=1&amp;subtype=1&amp;unicast=true&amp;proto=Onvif"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890A8"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/subStreamButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="IMOU SUB 1" />

            <Button
                android:id="@+id/mainStreamButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="MAIN 0" />

            <CheckBox
                android:id="@+id/tcpCheck"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:checked="true"
                android:text="RTP/TCP"
                android:textColor="#DCEBFA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/connectButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="KẾT NỐI" />

            <Button
                android:id="@+id/disconnectButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="NGẮT" />

            <Button
                android:id="@+id/initAiButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="TẢI / MỞ AI" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:paddingTop="6dp"
        android:text="Giao diện sẵn sàng • chưa kết nối camera"
        android:textColor="#8DE7B0"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/modelProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:max="100"
        android:progress="0" />

    <FrameLayout
        android:id="@+id/videoFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="always"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <vn.bachphuc.trafficai.DetectionOverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/aiBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="#B0000000"
            android:padding="7dp"
            android:text="AI: CHƯA MỞ"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lightResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/result_background"
            android:gravity="center"
            android:text="ĐÈN\n—"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/countdownResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/result_background"
            android:gravity="center"
            android:text="GIÂY\n—"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/signResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:background="@drawable/result_background"
            android:gravity="center"
            android:maxLines="3"
            android:text="BIỂN BÁO\n—"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
