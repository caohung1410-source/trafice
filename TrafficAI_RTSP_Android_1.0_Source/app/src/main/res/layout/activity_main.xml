                            <Button android:id="@+id/disconnectButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="NGẮT" />
                            <Button android:id="@+id/initAiButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="MỞ AI" />
                        </LinearLayout>
