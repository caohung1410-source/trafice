                        <Button android:id="@+id/limit60Button" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="60" />
                        <Button android:id="@+id/limit80Button" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="80" />
                    </LinearLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:paddingTop="16dp" android:text="BẢN ĐỒ • DỮ LIỆU GIAO THÔNG" android:textColor="#236A9D" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/refreshTrafficMapButton" android:layout_width="match_parent" android:layout_height="44dp" android:text="NẠP BIỂN / ĐÈN / CAMERA OSM" />
