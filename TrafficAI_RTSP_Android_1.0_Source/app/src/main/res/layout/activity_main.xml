                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:paddingTop="16dp" android:text="CAMERA RTSP • IMOU C22E-A / H.264" android:textColor="#236A9D" android:textSize="12sp" android:textStyle="bold" />
